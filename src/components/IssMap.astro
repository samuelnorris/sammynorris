---

<svg
  class="iss-map__svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="World map showing the current position of the International Space Station"
  preserveAspectRatio="xMidYMid meet"
>
  <!-- Latitude / longitude grid -->
  <g class="iss-map__grid" aria-hidden="true">
    {lonLines.map((x) => (
      <line x1={x} y1="0" x2={x} y2={H} class:list={["iss-map__grid-line", { "is-axis": Math.round(x) === W / 2 }]} />
    ))}
    {latLines.map((y) => (
      <line x1="0" y1={y} x2={W} y2={y} class:list={["iss-map__grid-line", { "is-axis": Math.round(y) === H / 2 }]} />
    ))}
  </g>

  <!-- Continents -->
  <path class="iss-map__land" d={LAND} aria-hidden="true" />

  <!-- Orbital ground track (drawn by the client script) -->
  <path id="iss-track" class="iss-map__track" aria-hidden="true" />

  <!-- Live marker (positioned + revealed by the client script) -->
  <g id="iss-marker" class="iss-marker" aria-hidden="true" style="opacity:0">
    <circle class="iss-marker__glow" r="30" />
    <circle class="iss-marker__pulse" r="8" />
    <circle class="iss-marker__ring" r="8" />
    <circle class="iss-marker__core" r="3.4" />
  </g>
</svg>

<style>
  .iss-map__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Keep every stroke crisp and thin no matter how far the SVG is scaled up. */
  .iss-map__grid-line,
  .iss-map__land,
  .iss-map__track,
  .iss-marker__ring {
    vector-effect: non-scaling-stroke;
  }

  .iss-map__grid-line {
    stroke: var(--color-primary);
    stroke-width: 1;
    opacity: 0.08;
  }
  .iss-map__grid-line.is-axis {
    opacity: 0.16;
  }

  .iss-map__land {
    fill: color-mix(in srgb, var(--color-primary) 5%, transparent);
    stroke: var(--color-primary);
    stroke-width: 1;
    stroke-linejoin: round;
    opacity: 0.5;
  }

  .iss-map__track {
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 2 5;
    opacity: 0.55;
  }

  .iss-marker__glow {
    fill: var(--color-secondary);
    opacity: 0.16;
  }
  .iss-marker__ring {
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 1.5;
    opacity: 0.9;
  }
  .iss-marker__core {
    fill: var(--color-secondary);
  }
  .iss-marker__pulse {
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(1);
    opacity: 0;
    animation: iss-pulse 2.4s var(--ease-out, ease-out) infinite;
  }

  @keyframes iss-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70% { transform: scale(3.4); opacity: 0; }
    100% { transform: scale(3.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .iss-marker__pulse { animation: none; display: none; }
  }
</style>
