---
// The world map for the ISS tracker: a flat (equirectangular) drawing of the
// continents with a lat/long grid, an orbital ground-track path and the live
// marker. The land is real Natural Earth 50m data, projected to a 1000x500
// viewBox and drawn as a filled silhouette — see scripts/build-land.mjs, which
// generates land.ts. Everything here is static markup; the live positioning
// happens in the client script on the /iss page, which finds these elements by
// id.
import { SATELLITES } from "./satellites";
import { LAND } from "./land";

const W = 1000;
const H = 500;

// Grid lines every 30 degrees. Project the same way as the land: longitude
// -180..180 -> x 0..W, latitude 90..-90 -> y 0..H.
const lonLines: number[] = [];
for (let lon = -180; lon <= 180; lon += 30) lonLines.push(((lon + 180) / 360) * W);
const latLines: number[] = [];
for (let lat = 90; lat >= -90; lat -= 30) latLines.push(((90 - lat) / 180) * H);
---

<svg
  class="iss-map__svg"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="World map showing the current position of the International Space Station"
  preserveAspectRatio="xMidYMid meet"
>
  <!-- Base art (grid + continents), grouped so the mobile follow-cam can show
       a second copy one world-width to the right when its window hangs past
       the antimeridian. On desktop the copy sits outside the viewBox. -->
  <g id="world-base" aria-hidden="true">
    <g class="iss-map__grid">
      {lonLines.map((x) => (
        <line x1={x} y1="0" x2={x} y2={H} class:list={["iss-map__grid-line", { "is-axis": Math.round(x) === W / 2 }]} />
      ))}
      {latLines.map((y) => (
        <line x1="0" y1={y} x2={W} y2={y} class:list={["iss-map__grid-line", { "is-axis": Math.round(y) === H / 2 }]} />
      ))}
    </g>
    <path class="iss-map__land" d={LAND} />
  </g>
  <use href="#world-base" x={W} aria-hidden="true" />

  <!-- Ground track for whichever satellite is hovered. One path, recoloured by
       the client script via a data-sat attribute. -->
  <path id="sat-track" class="iss-map__track" aria-hidden="true" />

  <!-- Live markers (positioned + revealed by the client script). Every marker
       carries a glow and pulse, lit while it is hovered or selected. -->
  {SATELLITES.map((sat) => (
    <g
      id={`sat-marker-${sat.id}`}
      class:list={["iss-marker", `is-${sat.id}`, { "is-primary": sat.primary }]}
      data-sat={sat.id}
      aria-hidden="true"
      style="opacity:0"
    >
      <circle class="iss-marker__glow" r={sat.primary ? 36 : 25} />
      <circle class="iss-marker__pulse" r={sat.primary ? 9.6 : 6.6} />
      <circle class="iss-marker__ring" r={sat.primary ? 9.6 : 6.6} />
      <circle class="iss-marker__core" r={sat.primary ? 4.1 : 2.9} />
      <!-- Generous invisible target so hovering the marker isn't fiddly. -->
      <circle class="iss-marker__hit" r="18" />
    </g>
  ))}
</svg>

<style>
  .iss-map__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The SVG itself ignores pointers; only the marker hit targets take them, so
     hovering the map at large doesn't interfere with the page. */
  .iss-map__svg {
    pointer-events: none;
  }

  /* Keep every stroke crisp and thin no matter how far the SVG is scaled up. */
  .iss-map__grid-line,
  .iss-map__track,
  .iss-marker__ring {
    vector-effect: non-scaling-stroke;
  }

  .iss-map__grid-line {
    stroke: var(--color-primary);
    stroke-width: 1;
    opacity: 0.08;
  }
  .iss-map__grid-line.is-axis {
    opacity: 0.16;
  }

  /* Land reads as a filled silhouette rather than an outline: with no coastline
     stroke there is no thin line to go jagged where the source data is coarse,
     and the shape's edge antialiases smoothly at any scale. fill-rule keeps the
     one interior ring in the source punched out rather than filled. */
  .iss-map__land {
    fill: color-mix(in srgb, var(--color-primary) 16%, transparent);
    fill-rule: evenodd;
    stroke: none;
  }

  /* Per-satellite colours. The ISS keeps the site accent; Hubble gets a hue
     that holds up on both the light and dark page backgrounds. */
  .iss-map__svg {
    --sat-iss: var(--color-secondary);
    --sat-hst: #6A4FB6;
  }
  :global(.dark) .iss-map__svg {
    --sat-hst: #A98CFF;
  }
  .is-iss { --sat-color: var(--sat-iss); }
  .is-hst { --sat-color: var(--sat-hst); }

  .iss-map__track {
    fill: none;
    stroke: var(--sat-color, var(--color-secondary));
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 2 5;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .iss-map__track.is-visible {
    opacity: 0.55;
  }

  .iss-marker {
    transition: opacity 0.3s ease;
  }
  /* Hovering one satellite dims the others so the active one reads clearly. */
  .iss-map__svg.has-active .iss-marker:not(.is-active) {
    opacity: 0.35 !important;
  }

  .iss-marker__hit {
    fill: transparent;
    pointer-events: all;
    cursor: pointer;
  }

  /* Markers rest as quiet dots; the glow lights while hovered or active, and
     on the mobile map the selected satellite keeps it on. */
  .iss-marker__glow {
    fill: var(--sat-color);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .iss-marker.is-active .iss-marker__glow {
    opacity: 0.16;
  }
  @media (hover: none) and (max-width: 768px) {
    .iss-marker__glow { opacity: 0.16; }
  }
  .iss-marker__ring {
    fill: none;
    stroke: var(--sat-color);
    stroke-width: 1.5;
    opacity: 0.9;
  }
  .iss-marker__core {
    fill: var(--sat-color);
  }
  .iss-marker__pulse {
    fill: none;
    stroke: var(--sat-color);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(1);
    opacity: 0;
  }
  /* The hovered / tapped marker pulses; on the mobile map the selected
     satellite pulses without needing a tap. */
  .iss-marker.is-active .iss-marker__pulse {
    animation: iss-pulse 2.4s var(--ease-out, ease-out) infinite;
  }
  @media (hover: none) and (max-width: 768px) {
    .iss-marker__pulse {
      animation: iss-pulse 2.4s var(--ease-out, ease-out) infinite;
    }
  }

  @keyframes iss-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70% { transform: scale(3.4); opacity: 0; }
    100% { transform: scale(3.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .iss-marker__pulse { animation: none; display: none; }
  }
</style>
