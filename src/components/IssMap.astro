// The world map for the ISS tracker: a flat (equirectangular) line drawing of
// the continents with a lat/long grid, an orbital ground-track path and the
// live marker. The land outline is real Natural Earth 110m data, projected to a
// 1000x500 viewBox and simplified to thin line-art (see scripts that generated
// it). Everything here is static markup; the live positioning happens in the
// client script on the /iss page, which finds these elements by id.
const W = 1000;
const H = 500;

// Grid lines every 30 degrees. Project the same way as the land: longitude
// -180..180 -> x 0..W, latitude 90..-90 -> y 0..H.
const lonLines: number[] = [];
for (let lon = -180; lon <= 180; lon += 30) lonLines.push(((lon + 180) / 360) * W);
const latLines: number[] = [];
for (let lat = 90; lat >= -90; lat -= 30) latLines.push(((90 - lat) / 180) * H);

