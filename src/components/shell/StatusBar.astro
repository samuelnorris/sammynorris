---
// The strip along the bottom edge. Sentence case, not the shouty uppercase of
// the site this pattern comes from — uppercase is reserved for eyebrows.
//
// The clock renders empty and is filled by shell.ts on the client: a
// server-rendered time would be the build machine's, and would be wrong the
// moment it was cached.

interface Props {
  name: string;
  role: string;
  place: string;
  /** IANA zone the clock reports in. */
  timeZone?: string;
}

const { name, role, place, timeZone = "Europe/London" } = Astro.props;
const year = new Date().getFullYear();
---

<div class="status-bar">
  <div class="status-bar__group">
    <span class="status-bar__name">{name}</span>
    <span class="status-bar__role">{role}</span>
  </div>

  <div class="status-bar__group">
    <span class="status-bar__place">{place}</span>
    <span
      class="status-bar__clock"
      data-clock
      data-timezone={timeZone}
      aria-hidden="true"
    ></span>
    <span class="status-bar__year">{year}</span>
  </div>
</div>
