---
// Top-centre "currently at" marker. A pulsing dot plus the employer — the
// live tell that this is a person, not a brochure.

interface Props {
  employer: string;
  href?: string;
}

const { employer, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  class="pill glass"
  href={href}
  {...(href ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  data-cuelume-hover={href ? "tick" : undefined}
>
  <span class="pill__dot" aria-hidden="true"></span>
  <span class="pill__prefix">Currently at</span>
  <span class="pill__employer">{employer}</span>
</Tag>
