---
// The menu body that grows out of the nav row. Lives inside .shellcard
// alongside the dock (see index.astro) so the two read as one piece of glass.
//
// Every view is rendered up front and stacked in the same box; shell.ts
// measures the target, animates the card's width and this body's height, and
// crossfades between views. Nothing is created at runtime, so the whole thing
// works before JS arrives and degrades to a plain list if it never does.
import { PROJECTS } from "../../data/projects";

interface Props {
  name: string;
  tagline: string;
  quote: string;
  bio: string;
}

const { name, tagline, quote, bio } = Astro.props;
---

<div
  class="panel"
  id="shell-panel"
  role="region"
  aria-label="Site navigation panel"
  data-panel
>
    <!-- ---------- Home ---------- -->
    <div class="panel__view" data-view="home" data-w="420">
      <div class="home-card">
        <h1 class="home-card__name" id="typewriter" aria-label={name}>{name}</h1>
        <p class="home-card__tagline b3">
          Product <span class="home-card__accent">designer</span> {tagline}
        </p>
      </div>
    </div>

    <!-- ---------- Work list ---------- -->
    <div class="panel__view" data-view="work" data-w="420">
      <div class="panel__scroll">
        <div class="work-list">
          {PROJECTS.map((project) => (
            <button
              type="button"
              class="work-row"
              data-project={project.slug}
              data-cursor-label={project.read}
              data-cuelume-hover="tick"
              data-cuelume-press
              data-cuelume-release
            >
              <span class="work-row__tile" aria-hidden="true">{project.monogram}</span>
              <span class="work-row__text">
                <span class="work-row__title">{project.title}</span>
                <span class="work-row__meta">{project.discipline}</span>
              </span>
              <span class="work-row__year">{project.year}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ---------- Work detail, one per project ---------- -->
    {PROJECTS.map((project) => (
      <div class="panel__view" data-view={`detail:${project.slug}`} data-w="760">
        <div class="detail__head">
          <button type="button" class="detail__back" data-back data-cuelume-hover="tick" data-cuelume-press>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Work
          </button>
          <button type="button" class="detail__close" data-close aria-label="Close panel" data-cuelume-hover="tick" data-cuelume-press>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="detail">
          <div>
            <h2 class="detail__title">{project.title}</h2>
            <div class="detail__meta">
              <div>
                <span class="detail__label">Role</span>
                <p class="detail__value">{project.role}</p>
              </div>
              <div>
                <span class="detail__label">{project.stat.label}</span>
                <p class="detail__value">{project.stat.value}</p>
              </div>
              <div>
                <span class="detail__label">About</span>
                <p class="detail__value">{project.summary}</p>
              </div>
              <a
                class="detail__cta"
                href={`/${project.slug}`}
                data-cuelume-hover="chime"
                data-cuelume-press="pulse"
              >
                Read the case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <div class="detail__media" aria-hidden="true">
            <div class="detail__hero">
              <img
                src={`/images/projects/${project.slug}-desktop.webp`}
                alt=""
                loading="lazy"
                decoding="async"
                width="2000"
                height="1500"
              />
            </div>
            <div class="detail__strip">
              {[1, 2, 3].map((n) => (
                <div class="detail__thumb">
                  <img
                    src={`/images/projects/${project.slug}/image-${project.slug}-${n}.webp`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- ---------- About ---------- -->
    <div class="panel__view" data-view="about" data-w="420">
      <div class="panel__scroll">
        <div class="about-card">
          <blockquote class="about-card__quote">{quote}</blockquote>
          <p class="about-card__body">{bio}</p>
          <div class="about-card__links">
            <a class="about-card__link" href="/about" data-cuelume-hover="tick" data-cuelume-press>
              More about me
            </a>
            <a class="about-card__link" href="/iss" data-cuelume-hover="tick" data-cuelume-press>
              Satellites
            </a>
            <a class="about-card__link" href="/bmx" data-cuelume-hover="sparkle" data-cuelume-press>
              BMX
            </a>
            <a
              class="about-card__link"
              href="https://www.linkedin.com/in/sammy-norris-b0090912a/"
              target="_blank"
              rel="noopener noreferrer"
              data-cuelume-hover="tick"
              data-cuelume-press
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
</div>
