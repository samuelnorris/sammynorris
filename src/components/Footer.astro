---
// Site-wide footer: copyright only.
// Used on the homepage (below the closing CTA), every case study and the
// about page so the footer is identical across the site.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__bar">
    <span class="b4">&copy; {year} Sammy Norris</span>
  </div>
</footer>

<style>
  .site-footer {
    max-width: 1818px;
    width: 100%;
    box-sizing: border-box;
    padding: var(--space-act) var(--gutter) var(--space-bind);
  }

  .site-footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: var(--space-act) 20px var(--space-bind);
    }
  }
</style>
