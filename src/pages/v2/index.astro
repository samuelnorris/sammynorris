---
import Layout from "../../layouts/Layout.astro";
import Backdrop from "../../components/shell/Backdrop.astro";
import StatusPill from "../../components/shell/StatusPill.astro";
import Panel from "../../components/shell/Panel.astro";
import Dock from "../../components/shell/Dock.astro";
import StatusBar from "../../components/shell/StatusBar.astro";
import "../../styles/shell.css";
---

{/* A work-in-progress alternative to the homepage, kept off `/` so the live
    portfolio is untouched. `shell` fills the viewport and drops the site's
    floating controls; `noindex` keeps this out of search results, since it
    would otherwise read as duplicate content against the real homepage. */}
<Layout
  shell
  noindex
  title="Sammy Norris — v2"
  description="Work in progress: an alternative homepage for sammynorris.com."
>

  {/* Stand-in footage so the glass can be judged against real motion. The clip
      is third-party and gitignored — swap `video` for the real backdrop, or
      drop the prop to fall back to the gradient. */}
  <Backdrop video="/video/backdrop-placeholder.mp4" loopSeconds={5} />

  <div class="shell">
    <StatusPill employer="Close Brothers" />

    {/* One card: the menu body on top, the nav row as its footer. The glass
        and the radius live on the wrapper so the two read as a single piece
        and the menu grows out of the navigation. */}
    <div class="panel-slot">
      <div class="shellcard glass" data-card>
        <Panel
          name="Sammy Norris"
          tagline="currently living in a regulated world."
          quote="Crafting clarity from complexity in regulated environments."
          bio="Senior Product Designer with experience delivering complex digital products across automotive and financial services. I focus on the full product lifecycle - from discovery and service design through to delivery - collaborating with engineering, legal, and compliance teams."
        />
        <Dock />
      </div>
    </div>
  </div>

  <StatusBar
    name="Sammy Norris"
    role="Senior Product Designer"
    place="London"
  />

  <!-- Custom cursor bubble: types a project's reading time on hover. The outer
       element is positioned to the pointer; the inner element owns the
       pop-in entrance animation. -->
  <div class="cursor-bubble" aria-hidden="true">
    <div class="cursor-bubble__inner">
      <span class="cursor-bubble__text"></span>
      <svg class="cursor-bubble__tail" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M18 1 C 18 11 13.5 17 6.5 17 C 4.8 17 4.2 15.8 5.2 14.3 C 7 11.5 10 12.8 12.5 11 C 14.6 9.4 16 5.6 18 6 Z" />
      </svg>
    </div>
  </div>

</Layout>

<script>
  import "../../scripts/shell.ts";

  (function () {
    // The element is static markup in Panel.astro; assert so the narrowing
    // survives into the nested typing callbacks.
    const el = document.getElementById("typewriter")!;
    if (!el) return;

    // Skip animation if already played this session, arriving via anchor,
    // or if the user prefers reduced motion.
    const alreadyPlayed = sessionStorage.getItem('sn-intro-played');
    const arrivingViaAnchor = !!window.location.hash;
    if (alreadyPlayed || arrivingViaAnchor || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = "Sammy Norris";
      el.classList.add("typewriter--done");
      var tagline = document.querySelector<HTMLElement>('.home-card__tagline');
      if (tagline) {
        tagline.style.animation = 'none';
        tagline.style.opacity = '1';
      }
      return;
    }
    sessionStorage.setItem('sn-intro-played', '1');

    // Clear the server-rendered name so the typewriter builds it from empty.
    el.textContent = "";

    // Total sequence runs 3.7s; the tagline is hard-coded to fade in at 3.9s
    // (shell.css) — retime the two together with anything changed here.
    const typeSpeed = 120;
    const deleteSpeed = 100;
    const startDelay = 600;
    const pauseBeforeDelete = 600;
    const pauseBeforeRetype = 400;

    el.classList.add("typewriter--typing");

    function typeText(text: string, i: number, cb?: () => void) {
      if (i < text.length) {
        el.textContent += text[i];
        setTimeout(function () { typeText(text, i + 1, cb); }, typeSpeed);
      } else if (cb) {
        cb();
      }
    }

    function deleteChars(count: number, cb?: () => void) {
      var current = el.textContent || "";
      if (count > 0 && current.length > 0) {
        el.textContent = current.slice(0, -1);
        setTimeout(function () { deleteChars(count - 1, cb); }, deleteSpeed);
      } else if (cb) {
        cb();
      }
    }

    setTimeout(function () {
      typeText("Samuel", 0, function () {
        setTimeout(function () {
          deleteChars(3, function () {
            setTimeout(function () {
              typeText("my Norris", 0, function () {
                el.classList.remove("typewriter--typing");
                el.classList.add("typewriter--done");
              });
            }, pauseBeforeRetype);
          });
        }, pauseBeforeDelete);
      });
    }, startDelay);
  })();
</script>

<script>
  // Custom cursor bubble: on hover over a work row, types out that project's
  // reading time as an iMessage-style bubble (brand colours), holds, deletes,
  // then returns the native cursor. One shared bubble across all rows.
  (function () {
    const bubble = document.querySelector<HTMLElement>(".cursor-bubble")!;
    if (!bubble) return;

    // Pointer-only affordance — skip on touch / coarse pointers.
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    // Disable entirely when the user prefers reduced motion — no bubble at all.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = document.querySelectorAll<HTMLElement>("[data-cursor-label]");
    if (!cards.length) return;

    // <body> carries a transform while its page-enter animation plays, which
    // makes it (not the viewport) the containing block for any position:fixed
    // descendant during that window. Re-parent the bubble to <html> so it is
    // always a true viewport-fixed element.
    document.documentElement.appendChild(bubble);

    const textEl = bubble.querySelector<HTMLElement>(".cursor-bubble__text")!;

    const TYPE_MS = 50; // per character while typing out
    const DELETE_MS = 35; // per character while deleting
    const HOLD_MS = 1250; // pause once fully typed

    let timers: ReturnType<typeof setTimeout>[] = [];
    let activeCard: HTMLElement | null = null;
    let label = "";
    function clearTimers() {
      timers.forEach(clearTimeout);
      timers = [];
    }
    function after(ms: number, fn: () => void) {
      timers.push(setTimeout(fn, ms));
    }

    function move(e: MouseEvent) {
      bubble.style.transform =
        "translate(" + e.clientX + "px, " + e.clientY + "px) translate(8px, -100%)";
    }

    function hide() {
      // Cycle finished (or pointer left): shrink the bubble away and bring the
      // native cursor back over the row. The text clears only after the exit
      // transition, so the bubble doesn't blink empty while it shrinks.
      clearTimers();
      if (activeCard) activeCard.classList.remove("card--bubbling");
      activeCard = null;
      bubble.classList.remove("cursor-bubble--visible");
      after(200, function () { textEl.textContent = ""; });
    }

    function typeOut(i: number) {
      if (i > label.length) { after(HOLD_MS, function () { deleteBack(label.length - 1); }); return; }
      textEl.textContent = label.slice(0, i);
      after(TYPE_MS, function () { typeOut(i + 1); });
    }
    function deleteBack(i: number) {
      if (i < 0) { hide(); return; }
      textEl.textContent = label.slice(0, i);
      after(DELETE_MS, function () { deleteBack(i - 1); });
    }

    cards.forEach(function (card) {
      card.addEventListener("mouseenter", function (e) {
        clearTimers();
        if (activeCard && activeCard !== card) activeCard.classList.remove("card--bubbling");
        activeCard = card;
        label = card.getAttribute("data-cursor-label") || "";
        move(e);
        timers.push(setTimeout(function () {
          if (activeCard !== card) return;
          // Hide the native cursor (the bubble becomes the cursor) while animating.
          card.classList.add("card--bubbling");
          bubble.classList.add("cursor-bubble--visible");
          textEl.textContent = "";
          typeOut(0);
        }, 250));
      });
      card.addEventListener("mousemove", move);
      card.addEventListener("mouseleave", function () {
        if (activeCard === card) hide();
      });
    });
  })();
</script>
