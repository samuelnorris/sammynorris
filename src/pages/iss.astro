---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import IssMap from "../components/IssMap.astro";
import { SATELLITES } from "../components/satellites";
---

<Layout
  title="Where are the satellites? - Sammy Norris"
  description="A live tracker showing where the International Space Station, Tiangong and Hubble are right now, plotted on a world map with their position, speed and orbital ground tracks."
>
  <nav class="case-nav">
    <BackButton href="/" label="Back to home" />
  </nav>

  <section class="iss-page">
    <header class="iss-page__head">
      <p class="iss-page__eyebrow">Live &middot; low earth orbit</p>
      <h1 class="iss-page__title">Where are the <em>satellites</em>?</h1>
    </header>

    <div class="sat-toggles" role="group" aria-label="Satellites shown on the map">
      {SATELLITES.map((sat) => (
        <button
          type="button"
          class={`sat-toggle is-${sat.id}`}
          data-sat={sat.id}
          aria-pressed="true"
          data-cuelume-hover="tick"
          data-cuelume-toggle
        >
          <span class="sat-toggle__dot" aria-hidden="true"></span>
          <span class="sat-toggle__text">
            <span class="sat-toggle__name">{sat.name}</span>
            <span class="sat-toggle__blurb">{sat.blurb}</span>
          </span>
        </button>
      ))}
    </div>

    <figure class="iss-page__map" id="iss-map">
      <IssMap />
      <div class="iss-loader" id="iss-loader">
        <span class="iss-loader__spinner" aria-hidden="true"></span>
        <span class="iss-loader__text">Locating the satellites&hellip;</span>
      </div>
      <!-- The readout. Parked until a satellite is hovered or tapped, then
           positioned above its marker by the client script and kept there as
           the dot moves. Hidden from assistive tech, which is served by the
           status line further down instead. -->
      <div class="iss-bubble" id="iss-bubble" aria-hidden="true">
        <div class="iss-bubble__box">
          <p class="iss-bubble__name" id="b-name">ISS</p>
          <dl class="iss-bubble__stats">
            <div class="iss-bubble__row">
              <dt>Speed</dt>
              <dd id="b-spd">&mdash;</dd>
            </div>
            <div class="iss-bubble__row">
              <dt>Altitude</dt>
              <dd id="b-alt">&mdash;</dd>
            </div>
            <div class="iss-bubble__row">
              <dt>Latitude</dt>
              <dd id="b-lat">&mdash;</dd>
            </div>
            <div class="iss-bubble__row">
              <dt>Longitude</dt>
              <dd id="b-lng">&mdash;</dd>
            </div>
          </dl>
        </div>
      </div>
      <!-- Opening state, over everything else in the figure. A button rather
           than a div so it can be dismissed from the keyboard as well as by
           clicking. The map is already live underneath it — this covers the
           map, it doesn't hold it back. -->
      <button type="button" class="iss-intro" id="iss-intro">
        <span class="iss-intro__title">Open the map</span>
        <span class="iss-intro__sub">
          <span class="iss-intro__pointer">Then hover a satellite for its speed, altitude and position.</span>
          <span class="iss-intro__touch">
            <span class="iss-intro__line">The map follows one satellite at a time &mdash; switch between them above.</span>
            <span class="iss-intro__line">Then tap it for speed, altitude and position.</span>
          </span>
        </span>
      </button>
    </figure>

    <!-- The bubble is announced through here instead of directly: its numbers
         retick every second, which a live region would read out non-stop. This
         is written once, when a satellite is opened. -->
    <p class="visually-hidden" role="status" id="b-sr"></p>

    <p class="iss-page__note" id="iss-note">
      Orbits are propagated in your browser from public
      <span class="iss-page__nowrap">CelesTrak</span> orbital elements, refreshed
      a few times a day and cached locally. Nothing is stored about you.
    </p>
  </section>
</Layout>

<style>
  .case-nav { position: fixed; top: 24px; left: 24px; z-index: 100; }

  /* Site grid: 1818px measure with --gutter gutters, matching the homepage. */
  .iss-page {
    max-width: 1818px;
    width: 100%;
    padding: 128px var(--gutter) var(--space-act);
    box-sizing: border-box;
  }

  .iss-page__head {
    margin-bottom: var(--space-bind);
  }

  .iss-page__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-b4);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-secondary);
    margin: 0 0 16px;
  }

  /* Matches .hero__title (about + case studies) so page titles are consistent. */
  .iss-page__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
  }
  .iss-page__title em {
    font-style: italic;
    color: var(--color-secondary);
  }

  .iss-page__map {
    position: relative;
    margin: 0 0 var(--space-bind);
    border-radius: 18px;
    overflow: hidden;
    background:
      linear-gradient(to bottom,
        var(--color-card-image-bg) 0%,
        var(--color-card-bg) 100%);
    outline: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    outline-offset: -1px;
    box-shadow: 0 10px 40px -16px rgba(0, 0, 0, 0.4);
  }

  /* Shown until the first position fix arrives. The map draws underneath it, so
     the API's occasional slow response reads as "locating", not "broken". */
  .iss-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: color-mix(in srgb, var(--color-bg) 35%, transparent);
    transition: opacity 0.45s ease;
  }
  .iss-page__map.is-loaded .iss-loader {
    opacity: 0;
    pointer-events: none;
  }
  .iss-loader__spinner {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-secondary) 28%, transparent);
    border-top-color: var(--color-secondary);
    animation: iss-spin 0.8s linear infinite;
  }
  .iss-loader__text {
    font-family: var(--font-sans);
    font-size: var(--text-b3);
    font-weight: 300;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }
  @keyframes iss-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .iss-loader__spinner { animation: none; }
  }

  /* Opening state: the map sits behind glass until it's opened. It covers the
     loader as well, so the sequence reads as one thing — open the map, and
     either it's there or it's still finding the satellites. */
  .iss-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    border: 0;
    /* Enough to mute the map, not enough to hide it — the world showing
       through is the reason to open it. */
    background: color-mix(in srgb, var(--color-bg) 46%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    color: var(--color-primary);
    cursor: pointer;
    text-align: center;
    transition: opacity 0.5s var(--ease-out), backdrop-filter 0.5s var(--ease-out);
  }
  /* Lifts a little on approach, so it reads as the thing you press. */
  .iss-intro:hover,
  .iss-intro:focus-visible {
    background: color-mix(in srgb, var(--color-bg) 36%, transparent);
  }

  .iss-intro__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .iss-intro__sub {
    font-family: var(--font-sans);
    font-size: var(--text-b3);
    font-weight: 300;
    letter-spacing: -0.01em;
    opacity: 0.65;
    max-width: 34ch;
  }
  .iss-intro__touch { display: none; }
  /* Two separate instructions on touch — the chips above, then the dot below —
     so they don't run together into one sentence. */
  .iss-intro__line { display: block; }
  .iss-intro__line + .iss-intro__line { margin-top: 6px; }

  /* Dismissed: faded out and taken out of the tab order. */
  .iss-page__map.is-open .iss-intro {
    opacity: 0;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s var(--ease-out), backdrop-filter 0.5s var(--ease-out),
                visibility 0s linear 0.5s;
  }

  /* The readout: a speech bubble above the satellite, with a tail pointing
     back down at the dot. Opened by hovering with a mouse, or by tapping the
     dot on touch.

     The script sets left/top from the marker's own box and --tail-x for where
     the tail meets it, so a bubble pushed away from the map edge still points
     at the right dot. */
  .iss-bubble {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    /* Anchored by its bottom centre: the point the tail comes out of. */
    transform: translate(-50%, -100%);
    /* Must never take the hover off the marker underneath it. */
    pointer-events: none;
    --sat-iss: var(--color-secondary);
    --sat-css: #0F6F63;
    --sat-hst: #6A4FB6;
  }
  :global(.dark) .iss-bubble {
    --sat-css: #22AE96;
    --sat-hst: #A98CFF;
  }
  .iss-bubble.is-iss { --sat-color: var(--sat-iss); }
  .iss-bubble.is-css { --sat-color: var(--sat-css); }
  .iss-bubble.is-hst { --sat-color: var(--sat-hst); }
  /* Flipped under the dot when there isn't room above — the map is clipped to
     its rounded corners, so a bubble that overran the top would be cut off. */
  .iss-bubble.is-below {
    transform: translate(-50%, 0);
  }

  .iss-bubble__box {
    position: relative;
    min-width: 196px;
    padding: 11px 14px 12px;
    background: var(--color-card-bg);
    border: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-radius: 12px;
    box-shadow: 0 12px 32px -14px rgba(0, 0, 0, 0.5);
    /* Grows out of the tail rather than its own middle, so it reads as speech
       coming from the dot. */
    transform-origin: var(--tail-x, 50%) 100%;
    transform: scale(0.94);
    opacity: 0;
    transition: transform 0.34s var(--ease-pop), opacity 0.16s ease;
  }
  .iss-bubble.is-below .iss-bubble__box {
    transform-origin: var(--tail-x, 50%) 0;
  }
  .iss-bubble.is-open .iss-bubble__box {
    transform: scale(1);
    opacity: 1;
  }

  /* The tail: a square rotated onto its corner, showing the two borders that
     continue the box's outline. */
  .iss-bubble__box::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: var(--tail-x, 50%);
    width: 10px;
    height: 10px;
    margin-left: -5px;
    background: var(--color-card-bg);
    border-right: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-bottom-right-radius: 3px;
    transform: rotate(45deg);
  }
  .iss-bubble.is-below .iss-bubble__box::after {
    bottom: auto;
    top: -5px;
    border-right: 0;
    border-bottom: 0;
    border-left: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-bottom-right-radius: 0;
    border-top-left-radius: 3px;
  }

  /* Named in its own colour, tying the bubble to the chip and the marker. */
  .iss-bubble__name {
    font-family: var(--font-sans);
    font-size: var(--text-b3);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--sat-color);
    margin: 0 0 9px;
  }

  .iss-bubble__stats {
    display: grid;
    gap: 5px;
  }
  /* Label left, value right: at this size a stacked pair would make the bubble
     twice as tall for no more information. */
  .iss-bubble__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }
  .iss-bubble__row dt {
    font-family: var(--font-sans);
    font-size: var(--text-b4);
    font-weight: 400;
    letter-spacing: -0.01em;
    opacity: 0.55;
  }
  .iss-bubble__row dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-b3);
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .iss-bubble__box,
    .iss-bubble.is-open .iss-bubble__box {
      transform: none;
      transition: opacity 0.16s ease;
    }
  }
  /* Satellite toggles. Colours mirror the marker colours in IssMap.astro. */
  .sat-toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
    --sat-iss: var(--color-secondary);
    --sat-css: #0F6F63;
    --sat-hst: #6A4FB6;
  }
  :global(.dark) .sat-toggles {
    --sat-css: #22AE96;
    --sat-hst: #A98CFF;
  }
  .sat-toggle.is-iss { --sat-color: var(--sat-iss); }
  .sat-toggle.is-css { --sat-color: var(--sat-css); }
  .sat-toggle.is-hst { --sat-color: var(--sat-hst); }

  .sat-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-tertiary);
    border-radius: 99px;
    color: var(--color-primary);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .sat-toggle:hover {
    border-color: var(--sat-color);
  }
  /* Switched off: the whole chip recedes and the dot hollows out. */
  .sat-toggle[aria-pressed="false"] {
    opacity: 0.45;
  }
  .sat-toggle[aria-pressed="false"] .sat-toggle__dot {
    background: transparent;
  }

  .sat-toggle__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sat-color);
    border: 1.5px solid var(--sat-color);
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .sat-toggle__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: left;
  }
  .sat-toggle__name {
    font-size: var(--text-b3);
    font-weight: 400;
    line-height: 1.2;
  }
  .sat-toggle__blurb {
    font-size: var(--text-b4);
    font-weight: 300;
    opacity: 0.6;
    line-height: 1.2;
  }

  /* The intro's instruction swaps to tap at the breakpoint where the map
     becomes a follow-cam. */
  @media (max-width: 768px) {
    .iss-intro__pointer { display: none; }
    .iss-intro__touch { display: inline; }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0; border: 0;
    clip: rect(0 0 0 0); clip-path: inset(50%);
    overflow: hidden; white-space: nowrap;
  }

  .iss-page__note {
    font-family: var(--font-sans);
    font-size: var(--text-b3);
    font-weight: 300;
    opacity: 0.55;
    margin: 0;
    max-width: 640px;
  }
  .iss-page__nowrap { white-space: nowrap; }

  @media (max-width: 768px) {
    .case-nav { top: 16px; left: 16px; }
    .iss-page { padding: 96px 20px var(--space-act); }

    /* One scrolling row rather than a wrap. Three chips don't fit across a
       phone, and wrapping left the third stranded on a line of its own; here
       it's cut by the screen edge instead, which says "keep going" where the
       orphan said "bad layout".

       The -20px/+20px bleeds the scroller out to the screen edges and puts the
       gutter back inside it, so the cut happens at the edge of the display
       rather than at the page gutter with dead space beside it. The 4px of
       block padding is room for the focus ring, which the scroll container
       would otherwise clip; the bottom margin drops by the same 4px so the gap
       under the chips stays 20px. */
    .sat-toggles {
      gap: 8px;
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      margin: -4px -20px 16px;
      padding: 4px 20px;
      scrollbar-width: none;
    }
    .sat-toggles::-webkit-scrollbar { display: none; }
    /* Chips size to their content and never squash to fit the row. */
    .sat-toggle { padding: 6px 14px 6px 10px; flex: 0 0 auto; }

    /* Here the chips are a radio: one satellite is shown and followed, and
       tapping the other switches to it. So the unselected chip is the other
       choice, not a switched-off one — it keeps full contrast, and the
       selection is marked on the chosen chip rather than by fading the rest.
       A chip whose elements never loaded is still disabled, and still fades. */
    .sat-toggle[aria-pressed="false"]:not(:disabled) { opacity: 1; }
    .sat-toggle[aria-pressed="true"] {
      border-color: var(--sat-color);
      background-color: color-mix(in srgb, var(--sat-color) 12%, var(--color-card-bg));
    }
    .sat-toggle[aria-pressed="true"] .sat-toggle__name { font-weight: 500; }
  }
</style>

<script>
  // Live satellite tracker. Orbital elements (TLEs) come from CelesTrak and are
  // cached in localStorage; every position after that is propagated locally with
  // SGP4, so the map keeps moving without further network calls. The world map
  // and markers live in <IssMap />; we find them by id and drive them here.
  //
  // Validated against the WhereTheISS.at API this page used to call: over 1.5
  // orbits the local solution stayed within 0.3 km on the ground and 0.06 km
  // in altitude.
  import { twoline2satrec, propagate, gstime, eciToGeodetic, degreesLat, degreesLong, type SatRec } from "satellite.js";
  import { SATELLITES } from "../components/satellites";

  (function () {
    const W = 1000, H = 500;
    const SIDEREAL_DAY = 1436.068;               // minutes
    const TLE_TTL = 6 * 60 * 60 * 1000;          // TLEs drift slowly; don't refetch often
    const TLE_RETRY = 30 * 1000;                 // pause between attempts when nothing loads
    const TLE_TIMEOUT = 10 * 1000;               // cap a hung TLE request

    // Two ways to the same elements. CelesTrak publishes them; the TLE API
    // mirrors CelesTrak's data. CelesTrak refuses or silently drops connections
    // from whole networks from time to time, which used to leave the map stuck
    // on "Locating the satellites", so both are asked at once and the first
    // usable answer wins — the page keeps working while either one is down.
    const TLE_SOURCES = [
      {
        url: (catnr: number) =>
          "https://celestrak.org/NORAD/elements/gp.php?FORMAT=tle&CATNR=" + catnr,
        // Three lines: name, then the two element lines.
        parse: (body: string) => body.trim().split("\n").map((l) => l.trim()).slice(1, 3),
      },
      {
        url: (catnr: number) => "https://tle.ivanstanojevic.me/api/tle/" + catnr,
        parse: (body: string) => {
          const j = JSON.parse(body);
          return [j.line1, j.line2];
        },
      },
    ];

    const svg = document.querySelector(".iss-map__svg") as SVGSVGElement | null;
    const track = document.getElementById("sat-track");
    const mapFigure = document.getElementById("iss-map");
    const note = document.getElementById("iss-note");
    if (!svg || !track) return;

    // Equirectangular projection matching the map's 1000x500 viewBox.
    const projX = (lon: number) => ((lon + 180) / 360) * W;
    const projY = (lat: number) => ((90 - lat) / 180) * H;

    function fmtCoord(n: number, pos: string, neg: string) {
      return Math.abs(n).toFixed(2) + "° " + (n >= 0 ? pos : neg);
    }

    // The note doubles as the failure message; keep its markup so a successful
    // retry can put the original text back.
    const noteHtml = note ? note.innerHTML : "";
    let noteFailShown = false;
    function showError() {
      if (noteFailShown || !note) return;
      noteFailShown = true;
      note.textContent = "Couldn't fetch orbital elements just now — retrying shortly.";
    }
    function clearError() {
      if (!noteFailShown || !note) return;
      noteFailShown = false;
      note.innerHTML = noteHtml;
    }

    // ---- Satellite state ----------------------------------------------------
    type Tracked = {
      id: string; catnr: number; name: string; primary?: boolean;
      satrec: SatRec | null; visible: boolean;
      el: SVGGElement | null; btn: HTMLButtonElement | null;
    };
    const sats: Tracked[] = SATELLITES.map((s) => ({
      ...s,
      satrec: null,
      visible: true,
      el: document.getElementById("sat-marker-" + s.id) as SVGGElement | null,
      btn: document.querySelector(`.sat-toggle[data-sat="${s.id}"]`) as HTMLButtonElement | null,
    }));

    let active: Tracked | null = null;
    let sticky = false;      // set by tap/click, so touch users get a track too
    let ready = false;

    // ---- Mobile follow-cam ---------------------------------------------------
    // Below the mobile breakpoint the map becomes a square window on half the
    // world, auto-panned to keep the followed satellite centred. Everything is
    // done through the viewBox, so the art, markers and track scale together;
    // the <use> world copy in IssMap fills the window past the antimeridian.
    const FOLLOW_W = 500, FOLLOW_H = 500;
    const mobileMq = window.matchMedia("(max-width: 768px)");
    let follow = mobileMq.matches;
    let viewX = (W - FOLLOW_W) / 2;      // window origin, recentred every tick

    function followTarget() {
      if (active && active.visible && active.satrec) return active;
      const primary = sats.find((s) => s.primary);
      if (primary && primary.visible && primary.satrec) return primary;
      return sats.find((s) => s.visible && s.satrec) || null;
    }
    // Also carries the mode into the chips' group label. They mean different
    // things either side of the breakpoint — on/off switches on desktop, a
    // pick-one on mobile — and the styling that says so doesn't reach a
    // screen reader.
    const toggleGroup = document.querySelector(".sat-toggles");
    function applyViewBox() {
      svg!.setAttribute(
        "viewBox",
        follow ? viewX.toFixed(1) + " 0 " + FOLLOW_W + " " + FOLLOW_H : "0 0 " + W + " " + H
      );
      toggleGroup?.setAttribute(
        "aria-label",
        follow ? "Satellite shown on the map" : "Satellites shown on the map"
      );
    }
    applyViewBox();   // settle the square layout before the first fix arrives
    mobileMq.addEventListener("change", () => {
      if (ready) updateNow();   // its breakpoint re-read handles the flip
      else { follow = mobileMq.matches; applyViewBox(); }
    });

    // ---- Orbital elements ---------------------------------------------------
    async function loadTle(sat: Tracked) {
      const key = "tle:" + sat.catnr;
      try {
        const cached = JSON.parse(localStorage.getItem(key) || "null");
        if (cached && Date.now() - cached.t < TLE_TTL) return cached.l as string[];
      } catch { /* private mode, corrupt entry — just refetch */ }

      // One controller for the whole race: it caps a hung request, and aborts
      // whichever source is still in flight once another has answered.
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TLE_TIMEOUT);
      try {
        // Promise.any resolves on the first source that returns a usable pair,
        // and rejects only if every one of them fails.
        const l = await Promise.any(
          TLE_SOURCES.map(async (src) => {
            const res = await fetch(src.url(sat.catnr), { signal: ctrl.signal });
            if (!res.ok) throw new Error("TLE " + res.status);
            const pair = src.parse(await res.text());
            if (pair.length !== 2 || pair[0]?.[0] !== "1" || pair[1]?.[0] !== "2") {
              throw new Error("bad TLE");
            }
            return pair as string[];
          })
        );
        try { localStorage.setItem(key, JSON.stringify({ t: Date.now(), l })); } catch { /* ignore */ }
        return l;
      } finally {
        clearTimeout(timer);
        ctrl.abort();
      }
    }

    function stateAt(sat: Tracked, date: Date) {
      if (!sat.satrec) return null;
      const pv = propagate(sat.satrec, date);
      if (!pv) return null;
      // On a propagation error satellite.js hands back `true` in place of the
      // vectors, so check the shape rather than just truthiness.
      const { position, velocity } = pv;
      if (typeof position === "boolean" || typeof velocity === "boolean") return null;

      const gd = eciToGeodetic(position, gstime(date));
      return {
        lat: degreesLat(gd.latitude),
        lon: degreesLong(gd.longitude),
        alt: gd.height,
        vel: Math.hypot(velocity.x, velocity.y, velocity.z) * 3600,
      };
    }

    // ---- Hover bubble --------------------------------------------------------
    // The readout that pops above whichever satellite is being pointed at. It
    // takes its position from the marker's own box rather than from the
    // projection, so it stays right whatever the viewBox is doing, and it is
    // repositioned every tick so it rides along with the dot.
    const bubble = document.getElementById("iss-bubble");
    const bName = document.getElementById("b-name");
    const bSpd = document.getElementById("b-spd");
    const bAlt = document.getElementById("b-alt");
    const bLat = document.getElementById("b-lat");
    const bLng = document.getElementById("b-lng");
    const bSr = document.getElementById("b-sr");
    const BUBBLE_GAP = 18;    // clearance between the dot and the tip of the tail
    const BUBBLE_EDGE = 10;   // keeps the bubble off the map's rounded corners
    const TAIL_INSET = 18;    // keeps the tail clear of the bubble's own corners

    type Fix = { lat: number; lon: number; alt: number; vel: number };

    function placeBubble(sat: Tracked, st: Fix) {
      if (!bubble || !mapFigure || !sat.el) return;
      const mr = sat.el.getBoundingClientRect();
      if (!mr.width) return;
      const fr = mapFigure.getBoundingClientRect();
      const cx = mr.left + mr.width / 2 - fr.left;
      const cy = mr.top + mr.height / 2 - fr.top;

      // Written before the box is measured: the values set its width, so
      // measuring first would place the bubble using the previous reading.
      if (bSpd) bSpd.textContent = Math.round(st.vel).toLocaleString("en-GB") + " km/h";
      if (bAlt) bAlt.textContent = Math.round(st.alt).toLocaleString("en-GB") + " km";
      if (bLat) bLat.textContent = fmtCoord(st.lat, "N", "S");
      if (bLng) bLng.textContent = fmtCoord(st.lon, "E", "W");

      const box = bubble.firstElementChild as HTMLElement | null;
      const w = box ? box.offsetWidth : 0;
      const h = box ? box.offsetHeight : 0;

      // The map is clipped to its rounded corners, so a bubble that overran the
      // top would be cut in half. Put it under the dot instead when high up.
      const below = cy - BUBBLE_GAP - h < BUBBLE_EDGE;
      bubble.classList.toggle("is-below", below);

      // Held inside the map, then the tail is slid along the bubble by however
      // far that clamp moved it, so it still points at the satellite. The tail
      // itself is kept off the rounded corners: with the satellite that far out
      // the dot is nearly at the map's edge anyway, and a tail hanging off the
      // side of the bubble looks broken.
      const half = w / 2;
      const x = Math.min(Math.max(cx, half + BUBBLE_EDGE), fr.width - half - BUBBLE_EDGE);
      const tail = Math.min(Math.max(cx - x + half, TAIL_INSET), w - TAIL_INSET);
      bubble.style.left = x.toFixed(1) + "px";
      bubble.style.top = (below ? cy + BUBBLE_GAP : cy - BUBBLE_GAP).toFixed(1) + "px";
      bubble.style.setProperty("--tail-x", tail.toFixed(1) + "px");
    }

    function showBubble(sat: Tracked) {
      if (!bubble) return;
      const st = stateAt(sat, new Date());
      if (!st) return;
      // Reset to this satellite's colour, then place it before opening so it
      // never animates in from where the last one was.
      bubble.className = "iss-bubble is-" + sat.id;
      if (bName) bName.textContent = sat.name;
      placeBubble(sat, st);
      bubble.classList.add("is-open");
      // One snapshot for screen readers, rather than the per-second retick.
      if (bSr) {
        bSr.textContent =
          sat.name + ": " + Math.round(st.vel).toLocaleString("en-GB") + " km/h, " +
          Math.round(st.alt).toLocaleString("en-GB") + " km altitude, " +
          fmtCoord(st.lat, "north", "south") + ", " + fmtCoord(st.lon, "east", "west");
      }
    }

    function hideBubble() {
      bubble?.classList.remove("is-open");
      if (bSr) bSr.textContent = "";
    }

    // ---- Live markers + stats ------------------------------------------------
    // Everything here is local maths, so this can run often and cheaply. On
    // desktop the stats panel stays on the ISS: it's the subject of the page,
    // and swapping the numbers on hover would make an aria-live region announce
    // constantly. On mobile the chips are a radio, so the stats follow the
    // selected satellite — switching is deliberate there, not a hover flap.
    function updateNow() {
      const now = new Date();
      // Re-read the breakpoint each tick: cheap, and self-healing anywhere the
      // media-query change event gets deferred (e.g. hidden documents).
      if (follow !== mobileMq.matches) {
        follow = mobileMq.matches;
        applyViewBox();
        // Entering mobile: collapse to a single selected satellite. Leaving:
        // hand the always-on track back to the hover state (usually hidden).
        if (follow) {
          hideBubble();   // the layout is changing under it; start closed
          const t = followTarget();
          if (t) for (const s of sats) setVisible(s, s.id === t.id);
        } else {
          track!.setAttribute(
            "class",
            "iss-map__track" + (active ? " is-visible is-" + active.id : "")
          );
        }
      }
      // Recentre the follow window before positioning anything inside it.
      let followSat: Tracked | null = null;
      if (follow) {
        const target = followTarget();
        const st = target && stateAt(target, now);
        if (st) viewX = (((projX(st.lon) - FOLLOW_W / 2) % W) + W) % W;
        applyViewBox();
        followSat = target;
      }
      for (const sat of sats) {
        if (!sat.satrec || !sat.el) continue;
        const st = stateAt(sat, now);
        if (!st) continue;
        let mx = projX(st.lon);
        if (follow && mx < viewX) mx += W;   // appear on the wrapped world copy
        sat.el.setAttribute(
          "transform",
          "translate(" + mx.toFixed(1) + " " + projY(st.lat).toFixed(1) + ")"
        );
        sat.el.style.opacity = sat.visible ? "1" : "0";
        sat.el.style.pointerEvents = sat.visible ? "" : "none";

        // Ride the bubble along with the dot, and keep its numbers live.
        if (active && active.id === sat.id) placeBubble(sat, st);
      }
      if (!ready) {
        ready = true;
        if (mapFigure) mapFigure.classList.add("is-loaded");   // hide the loader on the first fix
      }
      // Mobile has no hover, so the selected satellite always shows its track.
      if (follow) {
        if (followSat) {
          track!.setAttribute("class", "iss-map__track is-visible is-" + followSat.id);
          drawTrack(followSat, now);
        }
      } else if (active) {
        drawTrack(active, now);
      }
    }

    // ---- Orbital ground track ------------------------------------------------
    // Drawn as exactly one map width of longitude, starting where the track
    // crosses the left edge (-180). Because that range maps left-to-right with
    // no wrap, the result is always a single unbroken stroke running edge to
    // edge through the marker: no antimeridian splits, no loose ends mid-ocean.
    const TRACK_SAMPLES = 96;

    // Degrees of longitude the ground track gains per minute: the orbit's own
    // rate, less the Earth turning underneath it. Derived per satellite from its
    // mean motion, so Hubble's wider orbit draws correctly alongside the ISS.
    function lonRate(satrec: SatRec) {
      const periodMin = (2 * Math.PI) / satrec.no;
      return (360 - (360 * periodMin) / SIDEREAL_DAY) / periodMin;
    }

    // Catmull-Rom -> cubic Bezier for a smooth curve through the sampled points.
    function buildTrackPath(pts: { x: number; y: number }[]) {
      if (pts.length < 2) return "";
      let d = "M" + pts[0].x.toFixed(1) + " " + pts[0].y.toFixed(1);
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i - 1] || pts[i];
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const p3 = pts[i + 2] || p2;
        const c1x = p1.x + (p2.x - p0.x) / 6;
        const c1y = p1.y + (p2.y - p0.y) / 6;
        const c2x = p2.x - (p3.x - p1.x) / 6;
        const c2y = p2.y - (p3.y - p1.y) / 6;
        d += "C" + c1x.toFixed(1) + " " + c1y.toFixed(1) + " " +
             c2x.toFixed(1) + " " + c2y.toFixed(1) + " " +
             p2.x.toFixed(1) + " " + p2.y.toFixed(1);
      }
      return d;
    }

    // Samples come back wrapped to -180..180; the ground track only ever moves
    // east, so unwrapping them into a rising series makes the path monotonic.
    function unwrap(arr: { lon: number; lat: number }[]) {
      const out: { lon: number; lat: number }[] = [];
      let offset = 0;
      for (let i = 0; i < arr.length; i++) {
        let lon = arr[i].lon + offset;
        if (i > 0) {
          while (lon < out[i - 1].lon) { offset += 360; lon = arr[i].lon + offset; }
        }
        out.push({ lon, lat: arr[i].lat });
      }
      return out;
    }

    // Clip the unwrapped series to [from, from + 360], interpolating latitude at
    // the two boundaries so the line lands exactly on the map edges.
    function clipToWidth(pts: { lon: number; lat: number }[], from: number) {
      const to = from + 360;
      const latAt = (lon: number) => {
        for (let i = 1; i < pts.length; i++) {
          if (pts[i].lon >= lon) {
            const a = pts[i - 1], b = pts[i];
            const t = (lon - a.lon) / (b.lon - a.lon);
            return a.lat + (b.lat - a.lat) * t;
          }
        }
        return pts[pts.length - 1].lat;
      };
      const inner = pts.filter((p) => p.lon > from && p.lon < to);
      const clipped = [{ lon: from, lat: latAt(from) }, ...inner];
      if (pts[pts.length - 1].lon >= to) clipped.push({ lon: to, lat: latAt(to) });
      return clipped.map((p) => ({ x: ((p.lon - from) / 360) * W, y: projY(p.lat) }));
    }

    function drawTrack(sat: Tracked, now: Date) {
      if (!sat.satrec) return;
      const here = stateAt(sat, now);
      if (!here) return;

      // Wind back to the track's most recent crossing of the left edge, with a
      // margin so the samples bracket it (the rate is an average, so the
      // estimate drifts a little); clipping below fixes the exact endpoints.
      const rate = lonRate(sat.satrec);
      const degSinceEdge = ((((here.lon + 180) % 360) + 360) % 360);
      const startMin = -(degSinceEdge / rate) - 8;
      const spanMin = 360 / rate + 16;          // one full map width, plus margin

      const samples: { lon: number; lat: number }[] = [];
      for (let i = 0; i < TRACK_SAMPLES; i++) {
        const t = new Date(now.getTime() + (startMin + (spanMin * i) / (TRACK_SAMPLES - 1)) * 60000);
        const st = stateAt(sat, t);
        if (st) samples.push({ lon: st.lon, lat: st.lat });
      }
      if (samples.length < 2) return;

      const pts = unwrap(samples);

      if (follow) {
        // Window space: anchor the unwrapped series to the marker's on-screen x
        // so the track passes exactly through the satellite, wrapped copy and
        // all. No clipping needed — the viewBox crops the overrun.
        let mx = projX(here.lon);
        if (mx < viewX) mx += W;
        const step = spanMin / (TRACK_SAMPLES - 1);
        const i0 = Math.max(0, Math.min(pts.length - 1, Math.round(-startMin / step)));
        const lonHere = here.lon + 360 * Math.round((pts[i0].lon - here.lon) / 360);
        track!.setAttribute("d", buildTrackPath(
          pts.map((p) => ({ x: mx + ((p.lon - lonHere) * W) / 360, y: projY(p.lat) }))
        ));
        return;
      }

      // First multiple of 360 off -180 at or after the first sample: the
      // longitude that sits exactly on the map's left edge.
      const from = pts[0].lon + ((((-180 - pts[0].lon) % 360) + 360) % 360);
      track!.setAttribute("d", buildTrackPath(clipToWidth(pts, from)));
    }

    // ---- Hover / tap: which satellite's orbit is traced ----------------------
    function setActive(sat: Tracked | null, isSticky = false) {
      if (sat && !sat.visible) sat = null;
      active = sat;
      sticky = !!sat && isSticky;
      svg!.classList.toggle("has-active", !!sat);
      for (const s of sats) s.el?.classList.toggle("is-active", !!sat && s.id === sat.id);
      track!.setAttribute(
        "class",
        "iss-map__track" + (sat ? " is-visible is-" + sat.id : "")
      );
      if (sat) showBubble(sat);
      else hideBubble();
      if (follow && ready) updateNow();   // recentre the window on the new target
      else if (sat) drawTrack(sat, new Date());
    }

    function setVisible(sat: Tracked, on: boolean) {
      sat.visible = on;
      sat.btn?.setAttribute("aria-pressed", String(on));
      if (sat.el) {
        sat.el.style.opacity = on && ready ? "1" : "0";
        sat.el.style.pointerEvents = on ? "" : "none";
      }
      if (!on && active && active.id === sat.id) setActive(null);
    }

    // Mobile: the chips act as a radio — exactly one satellite is shown and
    // followed, and tapping a chip switches the map to it.
    function selectOnly(sat: Tracked) {
      if (!sat.satrec) return;
      for (const s of sats) setVisible(s, s.id === sat.id);
      if (ready) updateNow();   // recentre the window on the new selection
    }

    for (const sat of sats) {
      // Touch is left to the click handler below. A finger fires pointerenter
      // on the way down too, which would open the bubble here and then let the
      // click read it as already-open and immediately close it again.
      sat.el?.addEventListener("pointerenter", (e) => {
        if ((e as PointerEvent).pointerType === "touch") return;
        if (!sticky) setActive(sat);
      });
      sat.el?.addEventListener("pointerleave", (e) => {
        if ((e as PointerEvent).pointerType !== "touch" && !sticky) setActive(null);
      });
      // Tap is the touch equivalent of hover: it pins the bubble and track
      // until tapped off.
      sat.el?.addEventListener("click", () => {
        setActive(active && active.id === sat.id ? null : sat, true);
      });

      sat.btn?.addEventListener("click", () => {
        if (follow) selectOnly(sat);
        else setVisible(sat, !sat.visible);
      });
      // Same again: on touch a chip switches which satellite is followed, and
      // the bubble is opened by tapping the dot itself.
      sat.btn?.addEventListener("pointerenter", (e) => {
        if ((e as PointerEvent).pointerType === "touch") return;
        if (!sticky) setActive(sat);
      });
      sat.btn?.addEventListener("pointerleave", (e) => {
        if ((e as PointerEvent).pointerType !== "touch" && !sticky) setActive(null);
      });
      sat.btn?.addEventListener("focus", () => { if (!sticky) setActive(sat); });
      sat.btn?.addEventListener("blur", () => { if (!sticky) setActive(null); });
    }

    // ---- Opening the map -----------------------------------------------------
    // The tracker has been running since page load; this only lifts the cover
    // off it, so the map is live the moment it's revealed rather than starting
    // a fetch on the click. Dismissing from the keyboard would otherwise strand
    // focus on a control that no longer exists, so it's handed to the first
    // chip — but only for keyboard use, since moving focus after a mouse click
    // would pop a bubble open on its own.
    const intro = document.getElementById("iss-intro");
    intro?.addEventListener("click", () => {
      const byKeyboard = intro.matches(":focus-visible");
      mapFigure?.classList.add("is-open");
      if (byKeyboard) sats.find((s) => s.btn)?.btn?.focus();
    });

    // A tap anywhere else releases a pinned track.
    document.addEventListener("click", (e) => {
      if (!sticky) return;
      const t = e.target as Element | null;
      if (t && (t.closest(".iss-marker") || t.closest(".sat-toggle"))) return;
      setActive(null);
    });

    // ---- Ticking (paused while the tab is hidden) ----------------------------
    // Propagation is local, so a 1s tick is cheap and the markers glide rather
    // than jump the way the old 5s API poll did.
    let nowTimer: ReturnType<typeof setInterval> | null = null;
    function start() {
      if (nowTimer || !sats.some((s) => s.satrec)) return;
      updateNow();
      nowTimer = setInterval(updateNow, 1000);
    }
    function stop() {
      if (nowTimer) { clearInterval(nowTimer); nowTimer = null; }
    }
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop(); else start();
    });

    // Fetch every satellite's elements, then start. One failure doesn't stop the
    // others: a satellite without a TLE simply never appears. When nothing loads
    // at all (offline, CelesTrak down), keep retrying quietly so the page
    // recovers on its own once the network comes back.
    function loadAll() {
      Promise.all(
        sats.filter((s) => !s.satrec).map((sat) =>
          loadTle(sat)
            .then((l) => {
              sat.satrec = twoline2satrec(l[0], l[1]);
              if (sat.btn) sat.btn.disabled = false;
            })
            .catch(() => { if (sat.btn) sat.btn.disabled = true; })
        )
      ).then(() => {
        if (!sats.some((s) => s.satrec)) {
          showError();
          setTimeout(loadAll, TLE_RETRY);
          return;
        }
        clearError();
        for (const sat of sats) if (!sat.satrec) setVisible(sat, false);
        // Mobile starts with just the primary satellite selected.
        if (follow) {
          const first = sats.find((s) => s.primary && s.satrec) || sats.find((s) => s.satrec);
          if (first) for (const s of sats) setVisible(s, s.id === first.id);
        }
        start();
      });
    }
    loadAll();
  })();
</script>
