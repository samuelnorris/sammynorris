      .finance__value {
        font-weight: 600;
        white-space: nowrap;
      }

      .finance__edit {
        display: none;
        align-items: center;
        gap: 4px;
        flex: none;
        width: 108px;
        padding: 6px 10px;
        border: 1px solid var(--line);
        border-radius: 6px;
      }

      .finance__edit input {
        width: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        text-align: right;
        color: inherit;
      }

      .finance__edit input:focus {
        outline: none;
      }

      .finance__edit:focus-within {
        border-color: var(--blue);
      }

      .finances--editing .finance__value {
        display: none;
      }

      .finances--editing .finance__edit {
        display: flex;
      }

      .panel--partner {
        background: var(--blue-deep);
