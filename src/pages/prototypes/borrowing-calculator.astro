---
// Close Brothers Motor Finance — retention borrowing calculator.
// A self-contained mobile prototype: it deliberately does NOT use the site
// Layout, because it needs to look like the client's product rather than the
// portfolio. Everything (styles, logic, copy) lives in this one file so it can
// be lifted out, shared, or handed over without dragging the site with it.
import "@fontsource-variable/geist";

const terms = [12, 24, 36, 48, 60];

const creditBands = [
  {
    id: "excellent",
    label: "Excellent",
    apr: 8.9,
    blurb: "No missed payments, long credit history, low balances.",
  },
  {
    id: "good",
    label: "Good",
    apr: 10.9,
    blurb: "A steady record with the odd late payment a while back.",
  },
  {
    id: "fair",
    label: "Fair",
    apr: 14.9,
    blurb: "Some missed payments, or a thinner credit history.",
  },
  {
    id: "poor",
    label: "Poor",
    apr: 19.9,
    blurb: "Defaults, a CCJ, or you're new to credit entirely.",
  },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0f1f3d" />
    <title>Borrowing calculator — mobile prototype</title>
    <meta
      name="description"
      content="Mobile prototype of a retention borrowing calculator: work out a vehicle budget from a monthly budget, or a monthly payment from a vehicle price."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <div class="stage">
      <header class="stage__bar">
        <div>
          <p class="stage__title">Borrowing calculator</p>
          <p class="stage__meta">Mobile prototype · 390&nbsp;×&nbsp;844</p>
        </div>
        <button type="button" class="stage__reset" id="restart">Reset</button>
      </header>

      <div class="phone">
        <div class="phone__screen" id="screen">
          <!-- App bar -->
          <header class="appbar">
            <span class="logo" aria-label="Close Brothers Motor Finance">
              <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <circle cx="16" cy="16" r="15" fill="currentColor"></circle>
                <path
                  d="M22.5 10.6A8.4 8.4 0 1 0 22.5 21.4 6.2 6.2 0 1 1 22.5 10.6Z"
                  fill="#fff"></path>
              </svg>
              <span class="logo__words">
                <span class="logo__name">Close Brothers</span>
                <span class="logo__unit">Motor Finance</span>
              </span>
            </span>
          </header>

          <main class="screen__body">
            <!-- ───────────────────────── Step 1 ───────────────────────── -->
            <section class="step" id="step1" aria-labelledby="step1-title">
              <p class="step__count">Step 1 of 2</p>
              <div class="progress" role="presentation"><span style="width: 50%"></span></div>

              <h1 class="step__title" id="step1-title">See what you could borrow</h1>

              <form id="calc" novalidate>
                <fieldset class="field">
                  <legend class="field__label">Base my calculation on</legend>
                  <div class="segment segment--2" data-cols="2">
                    <input type="radio" name="basis" id="basis-budget" value="budget" checked />
                    <label for="basis-budget">Monthly budget</label>
                    <input type="radio" name="basis" id="basis-price" value="price" />
                    <label for="basis-price">Price of vehicle</label>
                  </div>
                </fieldset>

                <div class="field">
                  <label class="field__label" for="amount" id="amount-label">Monthly budget</label>
                  <div class="stepper">
                    <button
                      type="button"
                      class="stepper__btn"
                      data-nudge="-1"
                      aria-label="Decrease amount">−</button>
                    <div class="stepper__value">
                      <span class="stepper__prefix" aria-hidden="true">£</span>
                      <input
                        id="amount"
                        name="amount"
                        type="text"
                        inputmode="numeric"
                        autocomplete="off"
                        value="189"
                        aria-describedby="amount-hint"
                      />
                    </div>
                    <button
                      type="button"
                      class="stepper__btn"
                      data-nudge="1"
                      aria-label="Increase amount">+</button>
                  </div>
                  <p class="field__hint field__hint--tight" id="amount-hint">
                    Anything from £50 to £1,500 a month.
                  </p>
                </div>

                <fieldset class="field">
                  <legend class="field__label">Over how many months?</legend>
                  <div class="pills">
                    {
                      terms.map((months) => (
                        <>
                          <input
                            type="radio"
                            name="term"
                            id={`term-${months}`}
                            value={months}
                            checked={months === 60}
                          />
                          <label for={`term-${months}`}>{months}</label>
                        </>
                      ))
                    }
                  </div>
                </fieldset>

                <fieldset class="field">
                  <legend class="field__label">My credit score is</legend>
                  <div class="segment segment--4" data-cols="4">
                    {
                      creditBands.map((band) => (
                        <>
                          <input
                            type="radio"
                            name="score"
                            id={`score-${band.id}`}
                            value={band.id}
                            data-apr={band.apr}
                            checked={band.id === "good"}
                          />
                          <label for={`score-${band.id}`}>{band.label}</label>
                        </>
                      ))
                    }
                  </div>
                  <details class="disclosure">
                    <summary>What does this mean?</summary>
                    <ul class="disclosure__list">
                      {
                        creditBands.map((band) => (
                          <li>
                            <strong>
                              {band.label} — around {band.apr}% APR
                            </strong>
                            <span>{band.blurb}</span>
                          </li>
                        ))
                      }
                    </ul>
                    <p class="disclosure__note">
                      Checking here has no impact on your credit score. We'll confirm your real rate
                      when you apply.
                    </p>
                  </details>
                </fieldset>

                <fieldset class="field">
                  <legend class="field__label">I want to add a cash deposit</legend>
                  <div class="segment segment--2" data-cols="2">
                    <input type="radio" name="hasDeposit" id="deposit-yes" value="yes" checked />
                    <label for="deposit-yes">Yes</label>
                    <input type="radio" name="hasDeposit" id="deposit-no" value="no" />
                    <label for="deposit-no">No</label>
                  </div>
                </fieldset>

                <div class="field reveal" id="deposit-panel">
                  <label class="field__label" for="deposit">What is the cash deposit?</label>
                  <p class="field__hint">A rough idea is fine for now.</p>
                  <div class="money">
                    <span class="money__prefix" aria-hidden="true">£</span>
                    <input
                      id="deposit"
                      name="deposit"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      value="3,000"
                    />
                  </div>
                </div>

                <fieldset class="field">
                  <legend class="field__label">I want to trade in my current vehicle</legend>
                  <p class="field__hint">Vehicle registration: AB21 XYZ</p>
                  <div class="segment segment--2" data-cols="2">
                    <input type="radio" name="hasTrade" id="trade-yes" value="yes" checked />
                    <label for="trade-yes">Yes</label>
                    <input type="radio" name="hasTrade" id="trade-no" value="no" />
                    <label for="trade-no">No</label>
                  </div>
                </fieldset>

                <div class="field reveal" id="trade-panel">
                  <label class="field__label" for="trade"
                    >What's the estimated value of your trade-in?</label
                  >
                  <p class="field__hint">A rough idea will do, we'll confirm the value later on.</p>
                  <div class="money">
                    <span class="money__prefix" aria-hidden="true">£</span>
                    <input
                      id="trade"
                      name="trade"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      value="8,000"
                    />
                  </div>
                  <p class="field__hint field__hint--tight">
                    We'll settle the £2,740 left on your current agreement and add it to what you
                    borrow.
                  </p>
                </div>
              </form>

              <!-- Result -->
              <section class="result" aria-labelledby="result-label">
                <div id="result-live" aria-live="polite">
                  <p class="result__label" id="result-label">Your vehicle budget</p>
                  <p class="result__figure" id="result-figure">£16,973</p>
                  <p class="result__sub" id="result-sub">
                    Estimated £189 a month over 60 months
                  </p>
                </div>

                <p class="badge" id="result-badge">
                  <span aria-hidden="true">✦</span> Saving you £569 by coming to us direct*
                </p>

                <p class="result__warning" id="result-warning" hidden></p>

                <dl class="rows" id="result-rows"></dl>

                <p class="result__note">
                  This is an example based on what you've told us. Your final offer will be
                  confirmed when you apply.
                </p>

                <button type="button" class="btn btn--primary" id="to-step2">
                  Continue to my offer
                </button>
                <button type="button" class="btn btn--ghost" id="cancel-1">Cancel</button>
              </section>

              <div class="legal">
                <p>
                  *Your saving estimate is based on comparing the average direct APR rate with the
                  average broker APR rate for the credit profile you've selected. The figures shown
                  are an example only. Your actual rate and savings will depend on your
                  circumstances and aren't guaranteed. Representative example: Using a conditional
                  sale product with a vehicle cash price of £11,200. Borrowing £10,000 over 60
                  months with a £1,200 deposit. Representative APR of 12.9% fixed rate. Monthly
                  repayment: £223.26. Option to Purchase Fee: £10. Total cost of credit: £3,405.60.
                  Total amount payable: £13,405.60.
                </p>
                <p>
                  Finance available to UK residents of 18 or over and is subject to status and
                  credit assessment. Indemnities may be required. You will not own the vehicle until
                  all payments are made. Terms and conditions apply. Finance provided by Close
                  Brothers Motor Finance (Lender). Close Brothers Limited ('CBL'), a subsidiary of
                  Close Brothers Group plc. CBL is registered in England and Wales with company
                  number 195626 and registered office 10 Crown Place, London, EC2A 4FT. CBL is
                  authorised and regulated by the Financial Conduct Authority. Firm reference number
                  124750.
                </p>
              </div>
            </section>

            <!-- ───────────────────────── Step 2 ───────────────────────── -->
            <section class="step" id="step2" aria-labelledby="step2-title" hidden>
              <p class="step__count">Step 2 of 2</p>
              <div class="progress" role="presentation"><span style="width: 100%"></span></div>

              <h1 class="step__title" id="step2-title">Check your details</h1>

              <section class="panel">
                <div class="panel__head">
                  <h2 class="panel__title">Your quote</h2>
                  <button type="button" class="link-btn" id="edit-quote">
                    Update <span aria-hidden="true">✎</span>
                  </button>
                </div>
                <dl class="rows" id="summary-rows"></dl>
              </section>

              <section class="panel">
                <div class="panel__head">
                  <h2 class="panel__title">Your finances</h2>
                  <button type="button" class="link-btn" id="edit-finances" aria-expanded="false">
                    Update <span aria-hidden="true">✎</span>
                  </button>
                </div>
                <p class="panel__hint">
                  Taken from your current agreement. Change anything that's out of date.
                </p>
                <div class="finances" id="finances">
                  <div class="finance" data-prefix="£">
                    <span class="finance__label" id="fin-income-label">Monthly income after tax</span>
                    <span class="finance__value" data-value>£3,200</span>
                    <span class="finance__edit">
                      <span class="money__prefix" aria-hidden="true">£</span>
                      <input
                        type="text"
                        inputmode="numeric"
                        value="3,200"
                        aria-labelledby="fin-income-label"
                      />
                    </span>
                  </div>
                  <div class="finance" data-prefix="£">
                    <span class="finance__label" id="fin-rent-label">Mortgage or rent payment</span>
                    <span class="finance__value" data-value>£950</span>
                    <span class="finance__edit">
                      <span class="money__prefix" aria-hidden="true">£</span>
                      <input
                        type="text"
                        inputmode="numeric"
                        value="950"
                        aria-labelledby="fin-rent-label"
                      />
                    </span>
                  </div>
                  <div class="finance">
                    <span class="finance__label" id="fin-deps-label"
                      >People financially dependent on you</span
                    >
                    <span class="finance__value" data-value>1</span>
                    <span class="finance__edit">
                      <input
                        type="text"
                        inputmode="numeric"
                        value="1"
                        aria-labelledby="fin-deps-label"
                      />
                    </span>
                  </div>
                  <div class="finance" data-prefix="£">
                    <span class="finance__label" id="fin-care-label"
                      >Monthly childcare or maintenance cost</span
                    >
                    <span class="finance__value" data-value>£0</span>
                    <span class="finance__edit">
                      <span class="money__prefix" aria-hidden="true">£</span>
                      <input
                        type="text"
                        inputmode="numeric"
                        value="0"
                        aria-labelledby="fin-care-label"
                      />
                    </span>
                  </div>
                </div>
                <button type="button" class="btn btn--secondary" id="save-finances" hidden>
                  Save changes
                </button>
              </section>

              <section class="panel panel--partner">
                <p class="partner__mark" aria-label="Zuto">Zuto</p>
                <p>
                  We've partnered with Zuto to manage your application from start to finish.
                </p>
                <p class="partner__agree">By continuing, I agree to:</p>
                <label class="check">
                  <input type="checkbox" id="agree-terms" />
                  <span>The <a href="#0">terms and conditions</a></span>
                </label>
                <label class="check">
                  <input type="checkbox" id="agree-share" />
                  <span>My application details being submitted to Zuto</span>
                </label>
              </section>

              <button type="button" class="btn btn--primary btn--stacked" id="submit" disabled>
                <span>Explore my loyalty offer</span>
                <small>No impact on your credit score</small>
              </button>
              <button type="button" class="btn btn--ghost" id="back-to-1">Back</button>

              <p class="aside">
                If we're unable to offer you a deal, Zuto may be able to find you a lender who can.
                <a href="#0">Tell me more about Zuto ›</a>
              </p>

              <div class="legal">
                <p>
                  If you use us to finance your next vehicle, we'll pay a commission to Zuto. This
                  is not an additional charge to you. This is a percentage of the amount you borrow.
                  It's a one-off payment (subject to a maximum limit) and doesn't impact the amount
                  you pay us. We'll tell you how much it is before you enter into the agreement with
                  us.
                </p>
                <p>
                  Zuto is a credit broker and not a lender. Zuto is acting as a data controller.
                  Read their <a href="#0">privacy policy and terms and conditions</a>.
                </p>
                <p>
                  To see how we'll use your personal information, read our
                  <a href="#0">privacy policy</a>. Your marketing preferences will be based on the
                  permissions we hold against your current agreement.
                </p>
              </div>
            </section>

            <!-- ───────────────────────── End state ───────────────────────── -->
            <section class="step" id="step3" aria-labelledby="step3-title" hidden>
              <div class="done">
                <span class="done__tick" aria-hidden="true">✓</span>
                <h1 class="step__title" id="step3-title">We're finding your loyalty offer</h1>
                <p>
                  We've passed your details to Zuto. You'll get a decision by email within a few
                  minutes, and we'll text you if we need anything else.
                </p>
                <dl class="rows" id="done-rows"></dl>
              </div>
              <button type="button" class="btn btn--ghost" id="start-over">
                Start the calculator again
              </button>
            </section>
          </main>

          <footer class="cb-footer">
            <ul class="cb-footer__links">
              <li><a href="#0">Privacy policy</a></li>
              <li><a href="#0">Cookie policy</a></li>
              <li><a href="#0">Terms and conditions</a></li>
              <li><a href="#0">Complaints</a></li>
            </ul>
            <span class="logo logo--footer" aria-hidden="true">
              <svg class="logo__mark" viewBox="0 0 32 32" focusable="false">
                <circle cx="16" cy="16" r="15" fill="currentColor"></circle>
                <path
                  d="M22.5 10.6A8.4 8.4 0 1 0 22.5 21.4 6.2 6.2 0 1 1 22.5 10.6Z"
                  fill="#1b4ca8"></path>
              </svg>
              <span class="logo__words">
                <span class="logo__name">Close Brothers</span>
              </span>
            </span>
            <p class="cb-footer__legal">© 2026 Close Brothers Limited. All rights reserved.</p>
          </footer>
        </div>
      </div>
    </div>

    <style is:global>
      :root {
        --ink: #0f1f3d;
        --ink-soft: #4a5872;
        --blue: #1a4fa0;
        --blue-deep: #14338b;
        --blue-footer: #1b4ca8;
        --yellow: #ffc833;
        --line: #d6dbe4;
        --line-soft: #e7eaf0;
        --panel: #f2f4f7;
        --white: #fff;
        --radius: 8px;
        --gap: 20px;
      }

      * {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: #14181f;
        color: var(--ink);
        font-family: "Geist Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Arial,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ── Stage (desktop chrome around the phone) ───────────────────── */
      .stage {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: 28px 16px 40px;
      }

      .stage__bar {
        width: min(390px, 100%);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        color: #dfe4ec;
      }

      .stage__title {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
      }

      .stage__meta {
        margin: 2px 0 0;
        font-size: 12px;
        color: #8b95a8;
      }

      .stage__reset {
        border: 1px solid #39414f;
        background: transparent;
        color: #dfe4ec;
        border-radius: 999px;
        padding: 7px 14px;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .stage__reset:hover {
        background: #222834;
      }

      .phone {
        width: min(390px, 100%);
        height: min(844px, calc(100dvh - 120px));
        border-radius: 44px;
        padding: 10px;
        background: #262c37;
        box-shadow:
          0 0 0 1px #3a4250,
          0 30px 70px rgba(0, 0, 0, 0.55);
      }

      .phone__screen {
        height: 100%;
        overflow-y: auto;
        overscroll-behavior: contain;
        background: var(--white);
        border-radius: 34px;
        scrollbar-width: none;
      }

      .phone__screen::-webkit-scrollbar {
        display: none;
      }

      @media (max-width: 520px) {
        .stage {
          padding: 0;
          gap: 0;
        }

        .stage__bar {
          display: none;
        }

        .phone {
          width: 100%;
          height: 100dvh;
          border-radius: 0;
          padding: 0;
          box-shadow: none;
        }

        .phone__screen {
          border-radius: 0;
        }
      }

      /* ── App bar ────────────────────────────────────────────────────── */
      .appbar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: var(--white);
        border-bottom: 1px solid var(--line-soft);
        padding: 14px 20px;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--ink);
      }

      .logo__mark {
        width: 26px;
        height: 26px;
        flex: none;
      }

      .logo__words {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .logo__name {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .logo__unit {
        font-size: 10px;
        color: var(--ink-soft);
      }

      .screen__body {
        padding: 22px 20px 32px;
      }

      /* ── Step scaffolding ───────────────────────────────────────────── */
      .step__count {
        margin: 0 0 8px;
        font-size: 13px;
        color: var(--ink-soft);
      }

      .progress {
        height: 4px;
        border-radius: 999px;
        background: var(--line-soft);
        overflow: hidden;
      }

      .progress span {
        display: block;
        height: 100%;
        background: var(--blue);
        border-radius: 999px;
        transition: width 0.3s ease;
      }

      .step__title {
        margin: 20px 0 24px;
        font-size: 30px;
        line-height: 1.15;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      /* ── Fields ─────────────────────────────────────────────────────── */
      .field {
        margin: 0 0 var(--gap);
        padding: 0;
        border: 0;
      }

      .field__label {
        display: block;
        margin: 0 0 8px;
        padding: 0;
        font-size: 16px;
        font-weight: 600;
      }

      .field__hint {
        margin: -4px 0 8px;
        font-size: 13px;
        color: var(--ink-soft);
      }

      .field__hint--tight {
        margin: 8px 0 0;
      }

      /* Segmented controls */
      .segment {
        display: grid;
        gap: 6px;
        border: 0;
      }

      .segment--2 {
        grid-template-columns: 1fr 1fr;
      }

      .segment--4 {
        grid-template-columns: repeat(4, 1fr);
      }

      .segment input,
      .pills input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
      }

      .segment label {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 6px 8px;
        text-align: center;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--white);
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease;
      }

      .segment label:hover {
        border-color: var(--blue);
      }

      .segment input:checked + label {
        background: var(--blue);
        border-color: var(--blue);
        color: var(--white);
      }

      .segment input:focus-visible + label,
      .pills input:focus-visible + label {
        outline: 3px solid #7aa4e8;
        outline-offset: 2px;
      }

      /* Term pills */
      .pills {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 6px;
      }

      .pills label {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          border-color 0.15s ease;
      }

      .pills label:hover {
        border-color: var(--blue);
      }

      .pills input:checked + label {
        background: var(--blue-deep);
        border-color: var(--blue-deep);
        color: var(--white);
      }

      /* Stepper */
      .stepper {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .stepper__btn {
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid var(--line);
        background: var(--white);
        color: var(--ink);
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
