      }

      /* ── Legal + footer ─────────────────────────────────────────────── */
      .legal {
        margin-top: 28px;
        display: grid;
        gap: 14px;
        font-size: 11px;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      .legal p {
        margin: 0;
      }

      a {
        color: var(--blue);
      }

      .cb-footer {
        margin-top: 8px;
        padding: 26px 20px 34px;
        background: var(--blue-footer);
        color: var(--white);
      }

      .cb-footer__links {
        margin: 0 0 22px;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 12px;
        font-size: 14px;
      }

      .cb-footer__links a {
        color: var(--white);
        text-decoration: none;
      }

      .cb-footer__links a:hover {
        text-decoration: underline;
      }

      .logo--footer {
        color: var(--white);
      }

      .logo--footer .logo__name {
        color: var(--white);
      }

      .cb-footer__legal {
        margin: 14px 0 0;
        font-size: 11px;
        opacity: 0.85;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>

    <script>
      // ── Model ────────────────────────────────────────────────────────
      // Everything here is illustrative prototype maths: a standard
      // amortising loan at a nominal APR, exactly as the static screens
      // were costed (£189 a month over 60 months at 10.9% = £8,713).
      const APRS: Record<string, number> = {
        excellent: 8.9,
        good: 10.9,
        fair: 14.9,
        poor: 19.9,
      };
      const BROKER_APR = 12.9; // average broker rate, for the saving badge
      const SETTLEMENT = 2740; // left on the customer's current agreement
      const MIN_LOAN = 1000;
      const MAX_LOAN = 50000;

      const LIMITS = {
        budget: { min: 50, max: 1500, step: 5, label: "Monthly budget" },
        price: { min: 2000, max: 75000, step: 250, label: "Price of vehicle" },
      } as const;

      type Basis = keyof typeof LIMITS;

      const gbp = (n: number) =>
        new Intl.NumberFormat("en-GB", {
          style: "currency",
          currency: "GBP",
          maximumFractionDigits: 0,
        }).format(Math.round(n));

      const num = (n: number) => new Intl.NumberFormat("en-GB").format(Math.round(n));

      /** Present value of `months` payments of 1, at a nominal APR. */
      const annuityFactor = (apr: number, months: number) => {
        const r = apr / 100 / 12;
        return r === 0 ? months : (1 - Math.pow(1 + r, -months)) / r;
      };

      const parseNum = (value: string) => {
        const digits = value.replace(/[^0-9]/g, "");
        return digits === "" ? 0 : parseInt(digits, 10);
      };

      const clamp = (n: number, min: number, max: number) => Math.min(Math.max(n, min), max);

      const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const checked = (name: string) =>
        (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;

      // ── Elements ─────────────────────────────────────────────────────
      const screen = el<HTMLDivElement>("screen");
      const amount = el<HTMLInputElement>("amount");
      const amountLabel = el<HTMLLabelElement>("amount-label");
      const amountHint = el<HTMLParagraphElement>("amount-hint");
      const deposit = el<HTMLInputElement>("deposit");
      const trade = el<HTMLInputElement>("trade");
      const depositPanel = el<HTMLDivElement>("deposit-panel");
      const tradePanel = el<HTMLDivElement>("trade-panel");
      const resultLabel = el<HTMLParagraphElement>("result-label");
      const resultFigure = el<HTMLParagraphElement>("result-figure");
      const resultSub = el<HTMLParagraphElement>("result-sub");
      const resultBadge = el<HTMLParagraphElement>("result-badge");
      const resultWarning = el<HTMLParagraphElement>("result-warning");
      const resultRows = el<HTMLDListElement>("result-rows");
      const summaryRows = el<HTMLDListElement>("summary-rows");
      const doneRows = el<HTMLDListElement>("done-rows");
      const continueBtn = el<HTMLButtonElement>("to-step2");
      const submitBtn = el<HTMLButtonElement>("submit");
      const nudgeBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-nudge]")
      );

      const DEFAULTS = { budget: 189, price: 16973 };
      let lastAmount = { ...DEFAULTS };

      // ── Calculation ──────────────────────────────────────────────────
      type Quote = ReturnType<typeof quote>;

      function quote() {
        const basis = checked("basis") as Basis;
        const months = parseInt(checked("term"), 10);
        const score = checked("score");
        const apr = APRS[score];
        const usesDeposit = checked("hasDeposit") === "yes";
        const usesTrade = checked("hasTrade") === "yes";

        const limits = LIMITS[basis];
        const entered = clamp(parseNum(amount.value), limits.min, limits.max);
        const depositValue = usesDeposit ? parseNum(deposit.value) : 0;
        const tradeValue = usesTrade ? parseNum(trade.value) : 0;
        const settlement = usesTrade ? SETTLEMENT : 0;

        const factor = annuityFactor(apr, months);

        let borrow: number;
        let monthly: number;
        let vehicle: number;

        if (basis === "budget") {
          monthly = entered;
          borrow = Math.round(monthly * factor);
          vehicle = borrow + depositValue + tradeValue - settlement;
        } else {
          vehicle = entered;
          borrow = Math.round(vehicle - depositValue - tradeValue + settlement);
          monthly = borrow > 0 ? Math.round(borrow / factor) : 0;
        }

        // What the same borrowing would cost at the average broker rate.
        const brokerMonthly = borrow / annuityFactor(BROKER_APR, months);
        const directMonthly = borrow / factor;
        const saving = Math.max(0, Math.round((brokerMonthly - directMonthly) * months));

        let warning = "";
        if (borrow < MIN_LOAN) {
          warning =
            borrow <= 0
              ? "Your deposit and trade-in already cover this — there's nothing left to finance."
              : `Our finance starts at ${gbp(MIN_LOAN)}. Try a longer term, a smaller deposit, or a higher vehicle price.`;
        } else if (borrow > MAX_LOAN) {
          warning = `We can lend up to ${gbp(MAX_LOAN)} online. Give us a call and we'll talk through the options.`;
        } else if (basis === "budget" && vehicle <= 0) {
          warning =
            "What's left on your current agreement is more than this budget covers. Try a longer term or a higher monthly budget.";
        }

        return {
          basis,
          months,
          apr,
          usesDeposit,
          usesTrade,
          depositValue,
          tradeValue,
          settlement,
          borrow,
          monthly,
          vehicle,
          saving,
          warning,
          valid: warning === "",
        };
      }

      // ── Rendering ────────────────────────────────────────────────────
      function row(term: string, value: string, total = false) {
        return `<div class="row${total ? " row--total" : ""}"><dt>${term}</dt><dd>${value}</dd></div>`;
      }

      function breakdown(q: Quote) {
        const bits: string[] = [];
        const vehicleTerm = q.basis === "budget" ? "Vehicle budget" : "Price of vehicle";

        if (q.usesDeposit || q.usesTrade) {
          bits.push(row(vehicleTerm, gbp(q.vehicle)));
          if (q.usesDeposit) bits.push(row("Cash deposit", `− ${gbp(q.depositValue)}`));
          if (q.usesTrade) {
            bits.push(row("Trade-in estimate", `− ${gbp(q.tradeValue)}`));
            bits.push(row("Settlement amount", `+ ${gbp(q.settlement)}`));
          }
        } else {
          bits.push(row("Vehicle worth", gbp(q.vehicle)));
        }

        bits.push(row("You'll borrow", gbp(q.borrow), true));
        bits.push(row(`Estimated ${gbp(q.monthly)} a month`, `${q.months} months`));
        bits.push(row("APR", `${q.apr.toFixed(1)}%`));
        return bits.join("");
      }

      function render() {
        const basis = checked("basis") as Basis;
        const limits = LIMITS[basis];

        // The stepper's label, bounds and hint follow whichever basis is on.
        amountLabel.textContent = limits.label;
        amountHint.textContent =
          basis === "budget"
            ? `Anything from ${gbp(limits.min)} to ${gbp(limits.max)} a month.`
            : `Anything from ${gbp(limits.min)} to ${gbp(limits.max)}.`;

        depositPanel.hidden = checked("hasDeposit") !== "yes";
        tradePanel.hidden = checked("hasTrade") !== "yes";

        const q = quote();
        lastAmount[basis] = clamp(parseNum(amount.value), limits.min, limits.max);

        const entered = parseNum(amount.value);
        nudgeBtns[0].disabled = entered <= limits.min;
        nudgeBtns[1].disabled = entered >= limits.max;

        if (basis === "price") {
          resultLabel.textContent = "Your estimated monthly payment";
          resultFigure.textContent = q.valid ? gbp(q.monthly) : "—";
          resultSub.textContent = `For a ${gbp(q.vehicle)} vehicle over ${q.months} months`;
        } else if (q.usesDeposit || q.usesTrade) {
          resultLabel.textContent = "Your vehicle budget";
          resultFigure.textContent = q.valid ? gbp(q.vehicle) : "—";
          resultSub.textContent = `Estimated ${gbp(q.monthly)} a month over ${q.months} months`;
        } else {
          resultLabel.textContent = "You could borrow";
          resultFigure.textContent = q.valid ? gbp(q.borrow) : "—";
          resultSub.textContent = `Estimated ${gbp(q.monthly)} a month over ${q.months} months`;
        }

        resultBadge.hidden = !q.valid || q.saving <= 0;
        resultBadge.innerHTML = `<span aria-hidden="true">✦</span> Saving you ${gbp(q.saving)} by coming to us direct*`;

        resultWarning.hidden = q.valid;
        resultWarning.textContent = q.warning;

        resultRows.innerHTML = q.valid ? breakdown(q) : "";
        continueBtn.disabled = !q.valid;

        return q;
      }

      // ── Wiring ───────────────────────────────────────────────────────
      const calc = el<HTMLFormElement>("calc");
      calc.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;

        // Switching basis swaps in the figure last used for that mode, so
        // flipping back and forth doesn't lose what someone typed.
        if (target.name === "basis") {
          const basis = target.value as Basis;
          amount.value = num(lastAmount[basis] || DEFAULTS[basis]);
        }
        render();
      });

      calc.addEventListener("input", (event) => {
        const target = event.target as HTMLInputElement;
        if (target === amount || target === deposit || target === trade) render();
      });

      // Tidy the typed figure once someone leaves the field.
      [amount, deposit, trade].forEach((input) => {
        input.addEventListener("blur", () => {
          const basis = checked("basis") as Basis;
          const value =
            input === amount
              ? clamp(parseNum(input.value), LIMITS[basis].min, LIMITS[basis].max)
              : parseNum(input.value);
          input.value = num(value);
          render();
        });
      });

      nudgeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const basis = checked("basis") as Basis;
          const { min, max, step } = LIMITS[basis];
          const direction = Number(btn.dataset.nudge);
          const next = clamp(parseNum(amount.value) + direction * step, min, max);
          amount.value = num(next);
          render();
        });
      });

      // ── Step navigation ──────────────────────────────────────────────
      const steps = [el<HTMLElement>("step1"), el<HTMLElement>("step2"), el<HTMLElement>("step3")];

      function show(index: number) {
        steps.forEach((step, i) => (step.hidden = i !== index));
        screen.scrollTo({ top: 0, behavior: "smooth" });
        const heading = steps[index].querySelector<HTMLElement>(".step__title");
        heading?.setAttribute("tabindex", "-1");
        heading?.focus({ preventScroll: true });
      }

      continueBtn.addEventListener("click", () => {
        const q = quote();
        if (!q.valid) return;
        summaryRows.innerHTML = [
          row(q.basis === "budget" ? "Vehicle budget" : "Price of vehicle", gbp(q.vehicle)),
          row("You'll borrow", gbp(q.borrow), true),
          row(`Estimated ${gbp(q.monthly)} a month`, `${q.months} months`),
          row("APR", `${q.apr.toFixed(1)}%`),
        ].join("");
        show(1);
      });

      el<HTMLButtonElement>("back-to-1").addEventListener("click", () => show(0));
      el<HTMLButtonElement>("edit-quote").addEventListener("click", () => show(0));

      // ── Finances (view ⇄ edit) ───────────────────────────────────────
      const finances = el<HTMLDivElement>("finances");
      const editFinances = el<HTMLButtonElement>("edit-finances");
      const saveFinances = el<HTMLButtonElement>("save-finances");

      editFinances.addEventListener("click", () => {
        finances.classList.add("finances--editing");
        editFinances.hidden = true;
        saveFinances.hidden = false;
        editFinances.setAttribute("aria-expanded", "true");
        finances.querySelector("input")?.focus();
      });

      saveFinances.addEventListener("click", () => {
        finances.querySelectorAll<HTMLElement>(".finance").forEach((rowEl) => {
          const input = rowEl.querySelector("input") as HTMLInputElement;
          const value = parseNum(input.value);
          input.value = num(value);
          const prefix = rowEl.dataset.prefix === "£";
          const display = rowEl.querySelector("[data-value]") as HTMLElement;
          display.textContent = prefix ? gbp(value) : num(value);
        });
        finances.classList.remove("finances--editing");
        editFinances.hidden = false;
        saveFinances.hidden = true;
        editFinances.setAttribute("aria-expanded", "false");
        editFinances.focus();
      });

      // ── Consent gate + submit ────────────────────────────────────────
      const agrees = [el<HTMLInputElement>("agree-terms"), el<HTMLInputElement>("agree-share")];
      agrees.forEach((box) =>
        box.addEventListener("change", () => {
          submitBtn.disabled = !agrees.every((b) => b.checked);
        })
      );

      submitBtn.addEventListener("click", () => {
        const q = quote();
        doneRows.innerHTML = [
          row("You'll borrow", gbp(q.borrow), true),
          row(`Estimated ${gbp(q.monthly)} a month`, `${q.months} months`),
          row("APR", `${q.apr.toFixed(1)}%`),
        ].join("");
        show(2);
      });

      // ── Reset ────────────────────────────────────────────────────────
      function reset() {
        el<HTMLInputElement>("basis-budget").checked = true;
        el<HTMLInputElement>("term-60").checked = true;
        el<HTMLInputElement>("score-good").checked = true;
        el<HTMLInputElement>("deposit-yes").checked = true;
        el<HTMLInputElement>("trade-yes").checked = true;
        amount.value = num(DEFAULTS.budget);
        deposit.value = num(3000);
        trade.value = num(8000);
        lastAmount = { ...DEFAULTS };
        agrees.forEach((box) => (box.checked = false));
        submitBtn.disabled = true;
        render();
        show(0);
      }

      el<HTMLButtonElement>("cancel-1").addEventListener("click", reset);
      el<HTMLButtonElement>("start-over").addEventListener("click", reset);
      el<HTMLButtonElement>("restart").addEventListener("click", reset);

      render();
    </script>
  </body>
</html>
