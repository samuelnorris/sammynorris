      }

      .btn--secondary {
        background: var(--white);
        border-color: var(--blue-deep);
        color: var(--blue-deep);
      }

      .btn--ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }

      .btn--ghost:hover {
        background: var(--panel);
      }

      .btn--stacked small {
        font-size: 12px;
        font-weight: 400;
        opacity: 0.85;
      }

      .btn:focus-visible,
      .link-btn:focus-visible,
      .stepper__btn:focus-visible,
      .stage__reset:focus-visible {
        outline: 3px solid #7aa4e8;
        outline-offset: 2px;
      }

      /* ── Step 2 panels ──────────────────────────────────────────────── */
      .panel {
        margin: 0 0 18px;
        padding: 18px;
        background: var(--panel);
        border-radius: 12px;
      }

      .panel__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .panel__title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
      }

      .panel__hint {
        margin: 6px 0 0;
        font-size: 13px;
        color: var(--ink-soft);
      }

      .link-btn {
        border: 0;
        background: none;
        padding: 0;
        font: inherit;
        font-size: 14px;
        color: var(--blue);
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      .finances {
        margin-top: 14px;
        display: grid;
        gap: 8px;
      }

      .finance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        background: var(--white);
